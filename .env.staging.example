# Staging. Copy to .env.staging.
#
# Secrets here are throwaway on purpose -- staging holds seeded data, never a
# production dump, so nothing in it is worth protecting. It is bound to
# 127.0.0.1 for the same reason: weak secrets are only acceptable while
# nothing outside the machine can reach them.

# Deliberately NOT "production": that sets Secure on the session cookie,
# which a browser drops over plain http, so sign-in would fail here for a
# reason unrelated to what is being measured. See docker-compose.staging.yml.
ENV=development

POSTGRES_DB=edunation_staging
POSTGRES_USER=edunation
POSTGRES_PASSWORD=staging-only-not-a-secret
DATABASE_URL=postgresql+asyncpg://edunation:staging-only-not-a-secret@postgres:5432/edunation_staging

REDIS_PASSWORD=staging-only-not-a-secret
REDIS_URL=redis://:staging-only-not-a-secret@redis:6379/0

JWT_SECRET=staging-only-not-a-secret-at-least-32-chars-long

# The load test drives the API through Caddy on this origin, and the CSRF
# origin check on /auth/refresh reads this list.
CORS_ORIGINS=http://localhost:58080,http://127.0.0.1:58080

VITE_API_BASE_URL=/api/v1

# --- the numbers under test -------------------------------------------------
# Identical to production. A staging box more generous than the real one
# answers the wrong question.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=30000
REDIS_SOCKET_TIMEOUT_SECONDS=2
PDF_IMPORT_QUEUE_WAIT_SECONDS=30
LEADERBOARD_CACHE_SECONDS=60
ENT_PDF_IMPORT_ENABLED=true

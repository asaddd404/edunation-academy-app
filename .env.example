ENV=development

POSTGRES_DB=edunation
POSTGRES_USER=edunation
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://edunation:changeme@postgres:5432/edunation

REDIS_URL=redis://redis:6379/0

JWT_SECRET=changeme-generate-a-real-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost,http://localhost:5173

# Relative on purpose: nginx serves the app and proxies /api/ on the same
# origin, so this works unchanged on localhost and on any production domain.
# An absolute http://localhost/... value would send the client's browser to
# THEIR machine and break every request.
VITE_API_BASE_URL=/api/v1

# Production environment. Copy to .env.prod on the server and fill in.
# NEVER reuse the development .env values here -- they are public defaults.
#
# Generate the two secrets with:
#   openssl rand -base64 32     # POSTGRES_PASSWORD (no ':' '@' '/' -- see below)
#   openssl rand -hex 48        # JWT_SECRET

# --- Domain / TLS -----------------------------------------------------------
# The domain must already point at this server's IP (A record) before the
# first start: Caddy validates ownership over HTTP to issue the certificate.
DOMAIN=example.kz
# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=you@example.kz

# --- Database ---------------------------------------------------------------
POSTGRES_DB=edunation
POSTGRES_USER=edunation
# Keep to letters/digits/-/_ : the password is embedded in DATABASE_URL below,
# where ':' '@' '/' '#' would be parsed as URL syntax and silently truncate it.
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_URL=postgresql+asyncpg://edunation:REPLACE_ME@postgres:5432/edunation

REDIS_URL=redis://redis:6379/0

# --- Auth -------------------------------------------------------------------
# Changing this invalidates every issued token, logging everyone out.
JWT_SECRET=REPLACE_ME
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- App --------------------------------------------------------------------
# The browser origin, used for CORS. Must be the https:// domain, not the IP.
CORS_ORIGINS=https://example.kz

# Relative on purpose: Caddy serves the app and proxies /api on one origin, so
# this works on any domain without a rebuild.
VITE_API_BASE_URL=/api/v1

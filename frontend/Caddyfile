# Edge server for production.
#
# Caddy rather than nginx specifically for the certificates: it obtains and
# renews Let's Encrypt certs automatically from the domain name alone, with no
# certbot, no renewal cron, and no chance of the site silently going insecure
# in 90 days. Everything else here mirrors nginx/nginx.dev.conf.
#
# {$DOMAIN} and {$ACME_EMAIL} come from the environment (see .env.prod).
{
	email {$ACME_EMAIL}

	servers {
		timeouts {
			# Slowloris defence, and the only place it can live: the attack
			# is a client that opens hundreds of connections and dribbles
			# headers a byte at a time, holding each one open. The
			# application never sees these requests -- there is nothing for
			# it to rate-limit -- so an unbounded header read is an
			# unbounded number of held connections.
			read_header 5s
			# The body cap for a 2 GB lesson video is a size, not a rate: a
			# slow uploader is legitimate on a school connection, so this is
			# generous rather than tight, and bounded rather than absent.
			read_body 15m
			# Not the 30s it was: Go's write timeout runs from the end of
			# the request headers to the end of the response, so it also
			# covers the time spent *receiving* the body. Every upload that
			# took longer than 30s was cut off mid-stream -- on a 1 MB/s
			# school connection, any lesson video over ~30 MB. It has to
			# outlast read_body, or read_body's 15 minutes can never happen.
			# Slow-client protection still comes from read_header and idle.
			write 16m
			idle 2m
		}
		max_header_size 16KB
	}
}

{$DOMAIN} {
	encode gzip zstd

	# Uploads, ordered most specific first: only the two routes that carry
	# large bodies get a large cap.
	#
	# Previously one 2100MB cap covered every /api/* route, which meant
	# /auth/login would read a two-gigabyte JSON body before the application
	# saw it. A limit that has to accommodate the largest legitimate upload
	# is the wrong limit for the other ninety endpoints.
	handle /api/v1/teacher/lessons/*/video {
		request_body {
			max_size 2100MB
		}
		reverse_proxy backend:8000
	}

	handle /api/v1/teacher/ent/questions/import-pdf {
		# MAX_ENT_PDF_SIZE in app/api/v1/ent_teacher.py, plus multipart
		# overhead.
		request_body {
			max_size 16MB
		}
		reverse_proxy backend:8000
	}

	# Homework: MAX_HOMEWORK_FILE_SIZE (10 MB) in app/core/storage.py, plus
	# multipart overhead. Under the 1 MB default below, every homework file
	# past 1 MB -- a phone photo of a written solution -- was refused here
	# with a 413 the app never saw.
	handle /api/v1/lessons/*/homework {
		request_body {
			max_size 11MB
		}
		reverse_proxy backend:8000
	}

	# Image uploads: the largest app-side cap is 5 MB (storage.py).
	@imageUploads path /api/v1/me/avatar /api/v1/teacher/categories/*/image /api/v1/teacher/lesson-content/image /api/v1/teacher/ent/questions/*/image
	handle @imageUploads {
		request_body {
			max_size 6MB
		}
		reverse_proxy backend:8000
	}

	# Everything else the API serves. 1 MB is well above any JSON this app
	# exchanges and well below anything worth reading into memory from an
	# unauthenticated caller.
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8000
	}

	# Build output is served before the SPA fallback and WITHOUT try_files, so
	# a missing chunk 404s instead of receiving index.html. With the fallback
	# applied here, a browser that still holds a previous build's index.html
	# asks for a since-deleted chunk, gets HTML with a 200, and refuses it on
	# MIME grounds -- a blank screen with no usable error. The router turns a
	# real 404 into a one-shot reload instead (see router/index.ts).
	handle /assets/* {
		root * /srv
		# Filenames are content-hashed, so a file that exists can be cached
		# indefinitely. The matcher matters: applied unconditionally, the
		# year-long immutable header also lands on 404s, and a browser that
		# happens to ask for a chunk mid-deploy would cache that 404 and keep
		# serving it long after the file appeared.
		@exists file {path}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		# .br/.gz siblings are written at build time (scripts/precompress.mjs):
		# maximum-level Brotli, compressed once instead of on every request.
		file_server {
			precompressed br gzip
		}
	}

	# Everything else is the SPA. try_files sends unknown paths to index.html
	# so client-side routes (/catalog, /lessons/70) survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# index.html must not be cached, or a deploy leaves clients on old bundles.
	@html path /index.html /
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# Only meaningful once the site is on https, which Caddy guarantees
		# here. A year, including subdomains: after the first visit the
		# browser refuses to talk to this host over plain http at all, which
		# is what closes the redirect-interception window on school wifi.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Report-Only on purpose, and it must stay that way until the reports
		# have been read. A CSP written blind against a Vue + KaTeX + HLS app
		# breaks something on day one, and a policy that breaks the site gets
		# deleted rather than fixed -- which leaves no policy at all. Collect
		# violations first, then flip the header name to Content-Security-Policy.
		#
		# Two entries are deliberate and will not be tightened:
		#   style-src 'unsafe-inline' -- KaTeX writes inline styles into every
		#     rendered formula; without it every lesson's maths collapses.
		#   img-src blob: -- hls.js and the editor preview use blob URLs.
		#   frame-src youtube-nocookie.com -- lesson videos hosted on YouTube;
		#     the player URL is rebuilt from a validated 11-character id.
		#   frame-src blob: -- the homework PDF preview: the file is fetched
		#     with the bearer token and shown from a blob: URL.
		# script-src has no 'unsafe-inline': the bundle is a static file, and
		# that is the entry that actually stops injected script.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; report-uri /api/v1/csp-report"

		# Caddy's own version banner tells an attacker which CVEs to try.
		-Server
	}
}
